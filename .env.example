# Copia este archivo como .env y cambia TODOS los valores. El archivo .env no se sube a Git.
# Valores pensados para el servidor de producción (ver DESPLIEGUE.md).

# Base de datos (contraseñas largas y distintas entre sí: openssl rand -base64 24)
DB_ROOT_PASS=cambia_esta_contrasena_root
DB_APP_PASS=cambia_esta_contrasena_app
DB_FLYWAY_PASS=cambia_esta_contrasena_flyway
# Puerto de MySQL, accesible solo desde el propio servidor (127.0.0.1)
DB_PORT=3308

# JWT: cadena aleatoria de al menos 32 caracteres (openssl rand -base64 48)
JWT_SECRET=

# Dirección con la que se abre el sistema, sin "/" al final (p. ej. https://sigclem.chilpancingo.tecnm.mx)
CORS_ORIGINS=http://localhost
# Puertos publicados por el servidor web
WEB_PORT=80
HTTPS_PORT=443
# Carpeta con fullchain.pem y privkey.pem. Si existen, deploy.sh publica HTTPS y redirige HTTP a HTTPS.
CERTS_DIR=./certs

# Swagger UI en /api/v1/docs/ui (true solo en desarrollo o pruebas)
API_DOCS=false

# MODO PRUEBAS: la API se usa sin iniciar sesión. Cada petición sin token se atiende como el usuario
# de la cabecera X-Usuario-Prueba o, si no se envía, como el coordinador. NUNCA true en producción.
MODO_PRUEBAS=false

# Cuentas iniciales: se crean solo si no existe una cuenta con ese rol (contraseña de 8 o más caracteres).
# Después del primer arranque borra las contraseñas de este archivo; el coordinador las cambia desde
# "Cuentas y contraseñas".
COORDINADOR_USUARIO=coordinador
COORDINADOR_CONTRASENA=
JEFA_USUARIO=jefa.dgtv
JEFA_CONTRASENA=
# Cuenta de administrador (opcional): el usuario de mayor privilegio (hace todo lo del coordinador y ve la
# bitácora de auditoría). Entra por el login normal. Solo se crea si defines usuario y contraseña; déjalas vacías
# si no la necesitas. Borra la contraseña de este archivo tras el primer arranque.
ADMIN_USUARIO=
ADMIN_CONTRASENA=

# Verificación automática de comprobantes de pago (CFDI)
# Consulta del estado del CFDI en el servicio público del SAT (sin credenciales). false = solo lectura del QR.
SAT_CONSULTA=true
# OCR para cotejar la descripción de recibos escaneados o fotografiados (Tesseract). En Docker ya viene
# instalado (tesseract). Vacío = sin OCR. En Windows (desarrollo) escribe la ruta, p. ej.:
# OCR_COMANDO=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_COMANDO=tesseract

# Memoria de la API: porcentaje de la RAM del contenedor para Java
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Djava.awt.headless=true

# Respaldos (scripts/respaldo.sh): carpeta y días que se conservan
RESPALDOS_DIR=./respaldos
RESPALDOS_DIAS=30
