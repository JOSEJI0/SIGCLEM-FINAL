# Configuración de SIGCLEM sin Docker: /etc/sigclem/sigclem.env (la crea instalar.sh con contraseñas aleatorias).
# Solo root puede leerlo. Tras modificarlo: sudo systemctl restart sigclem-api

DB_URL="jdbc:mysql://127.0.0.1:3306/sigclem?serverTimezone=America/Mexico_City&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
DB_USER=sigclem_app
DB_PASS=__DB_APP_PASS__
FLYWAY_USER=sigclem_flyway
FLYWAY_PASS=__DB_FLYWAY_PASS__

JWT_SECRET=__JWT_SECRET__
# Dirección con la que se abre el sistema, sin "/" al final
CORS_ORIGINS=http://localhost
ARCHIVOS_DIR=/srv/sigclem/archivos

API_DOCS=false
MODO_PRUEBAS=false
SAT_CONSULTA=true
OCR_COMANDO=tesseract

# Cuentas iniciales (solo se crean si no existen). Borra las contraseñas después del primer arranque.
COORDINADOR_USUARIO=coordinador
COORDINADOR_CONTRASENA=__COORDINADOR_CONTRASENA__
JEFA_USUARIO=jefa.dgtv
JEFA_CONTRASENA=__JEFA_CONTRASENA__
# Administrador (opcional): mayor privilegio, con bitácora de auditoría. Entra por el login normal.
ADMIN_USUARIO=
ADMIN_CONTRASENA=

JAVA_OPTS="-Xmx1g -Djava.awt.headless=true"

# Respaldos (respaldo.sh)
RESPALDOS_DIR=/var/backups/sigclem
RESPALDOS_DIAS=30
